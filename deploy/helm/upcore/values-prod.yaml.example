# Production override. Kopyala → values-prod.yaml, sonra imageTag'ini CI release job'u doldurur.

global:
  env: production
  logLevel: info
  imageTag: "v1.0.0"

services:
  api-gateway:
    replicas: 4
    resources:
      requests: { cpu: 500m, memory: 512Mi }
      limits:   { cpu: 2000m, memory: 2Gi }

  bordro:
    replicas: 3
    resources:
      requests: { cpu: 500m, memory: 1Gi }
      limits:   { cpu: 2000m, memory: 4Gi }

  web:
    replicas: 5

  # Minimal trafik alan servisler için 2 replika yeterli (default).
