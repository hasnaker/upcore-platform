PORT=8006
APP_ENV=development
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
REQUEST_TIMEOUT=60s

DATABASE_URL=postgres://upcore:upcore@localhost:5432/upcore_dev?sslmode=disable
DATABASE_MAX_OPEN=25
DATABASE_MAX_IDLE=5

# Azure Service Bus (optional; empty = no-op publisher)
SERVICE_BUS_CONNECTION_STRING=

# Azure Blob Storage (empty = in-memory blob store, dev only)
AZURE_BLOB_ACCOUNT_NAME=
AZURE_BLOB_ACCOUNT_KEY=
AZURE_BLOB_CONTAINER=documents
AZURE_BLOB_ENDPOINT=

MAX_UPLOAD_MB=50
SAS_READ_TTL_MIN=15
SAS_WRITE_TTL_MIN=15
EXPIRY_ALERT_DAYS=30

# Turkish e-signature providers (V1 stubs)
EIMZALA_API_KEY=
EIMZALA_BASE_URL=
KAMU_SM_API_KEY=
EDEVLET_CLIENT_ID=

JWT_ISSUER=upcore-auth
JWT_AUDIENCE=upcore-api
CORS_ALLOWED_ORIGINS=*
