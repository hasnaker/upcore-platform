# auth-service configuration

# HTTP
PORT=8001
APP_ENV=development
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
REQUEST_TIMEOUT=30s

# Database
DATABASE_URL=postgres://upcore:upcore_dev_password@localhost:5432/upcore_dev?sslmode=disable
DATABASE_MAX_OPEN=25
DATABASE_MAX_IDLE=5

# Redis
REDIS_URL=redis://:upcore_redis_dev@localhost:6379/0

# Azure Service Bus
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_NAMESPACE=upcore-dev

# Clerk
CLERK_WEBHOOK_SECRET=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=https://api.clerk.dev/v1/jwks
CLERK_ISSUER=https://clerk.upcore.app

# JWT
JWT_ISSUER=upcore-auth
JWT_AUDIENCE=upcore-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
JWKS_CACHE_TTL=1h

# CORS
CORS_ALLOWED_ORIGINS=*
