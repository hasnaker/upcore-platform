PORT=8003
APP_ENV=development
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
REQUEST_TIMEOUT=30s

DATABASE_URL=postgres://upcore:upcore@localhost:5432/upcore_dev?sslmode=disable
DATABASE_MAX_OPEN=25
DATABASE_MAX_IDLE=5

SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_NAMESPACE=

# CSV import batching
IMPORT_BATCH_SIZE=500
IMPORT_MAX_ROWS=10000
IMPORT_MAX_FILE_MB=10

# Auth service integration (for RBAC checks)
AUTH_SERVICE_URL=http://auth:8001
AUTH_SERVICE_TIMEOUT=500ms

JWT_ISSUER=upcore-auth
JWT_AUDIENCE=upcore-api

CORS_ALLOWED_ORIGINS=*
