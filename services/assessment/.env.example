PORT=8012
APP_ENV=development
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
REQUEST_TIMEOUT=60s

DATABASE_URL=postgres://upcore:upcore@localhost:5432/upcore_dev?sslmode=disable
DATABASE_MAX_OPEN=25
DATABASE_MAX_IDLE=5

REDIS_URL=localhost:6379
REDIS_TTL=24h
REDIS_PASSWORD=
REDIS_DB=0

SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_NAMESPACE=

# Auth service integration (for RBAC checks)
AUTH_SERVICE_URL=http://auth:8001
AUTH_SERVICE_TIMEOUT=500ms

# Psychometric scoring service
SCORING_SERVICE_URL=http://psychometric-scoring:8021
SCORING_SERVICE_TIMEOUT=30s

# Session defaults
SESSION_TIME_LIMIT_MINUTES=90
MAX_FOCUS_LOST_COUNT=3
MIN_TIME_PER_QUESTION_SEC=2

CORS_ALLOWED_ORIGINS=*
