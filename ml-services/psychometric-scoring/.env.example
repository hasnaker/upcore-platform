# Upcore Psychometric Scoring Service — environment template

# Service
SERVICE_NAME=psychometric-scoring
SERVICE_VERSION=0.1.0
LOG_LEVEL=INFO
PORT=8021
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://upcore:upcore@localhost:5432/upcore_psychometrics
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379/0
NORMS_CACHE_TTL=3600

# Default norm versions
DEFAULT_NORM_VERSION_BAT=bat12-tr-provisional-v0.1
DEFAULT_NORM_VERSION_UPCAP=upcap-tr-v0.1
DEFAULT_NORM_VERSION_COPSOQ=copsoq-iii-tr-v1.0

# Observability
OTEL_ENDPOINT=
SENTRY_DSN=
