  "items": [
    {"id": "bat_01", "subscale": "exhaustion", "text_tr": "Isimde kendimi bitkin hissediyorum.", "reverse_coded": false},
    {"id": "bat_02", "subscale": "exhaustion", "text_tr": "Is gununun sonunda fiziksel olarak yorgunum.", "reverse_coded": false},
    {"id": "bat_03", "subscale": "exhaustion", "text_tr": "Guc toplamak icin daha fazla zaman gerekiyor.", "reverse_coded": false},
    {"id": "bat_04", "subscale": "mental_distance", "text_tr": "Isim hakkinda dusunmek icin guc harcamakta zorlaniyorum.", "reverse_coded": false},
    {"id": "bat_05", "subscale": "mental_distance", "text_tr": "Isimden zihinsel olarak uzaklasiyorum.", "reverse_coded": false},
    {"id": "bat_06", "subscale": "mental_distance", "text_tr": "Islerime karsi kayitsiz hissediyorum.", "reverse_coded": false},
    {"id": "bat_07", "subscale": "cognitive_impairment", "text_tr": "Isimde konsantre olmakta zorlaniyorum.", "reverse_coded": false},
    {"id": "bat_08", "subscale": "cognitive_impairment", "text_tr": "Isimde dikkat dagilmasi yasiyorum.", "reverse_coded": false},
    {"id": "bat_09", "subscale": "cognitive_impairment", "text_tr": "Dusunmede yavaslama yasiyorum.", "reverse_coded": false},
    {"id": "bat_10", "subscale": "emotional_impairment", "text_tr": "Isimde kendimi kolayca sinirli hissediyorum.", "reverse_coded": false},
    {"id": "bat_11", "subscale": "emotional_impairment", "text_tr": "Isimde kucuk seylerden dolayi uzuluyorum.", "reverse_coded": false},
    {"id": "bat_12", "subscale": "emotional_impairment", "text_tr": "Duygularimi kontrol etmekte zorlaniyorum.", "reverse_coded": false}
  ]
}
