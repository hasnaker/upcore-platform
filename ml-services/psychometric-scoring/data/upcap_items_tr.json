  "items": [
    {"id": "upcap_01", "subscale": "hope", "text_tr": "Isimde suanki hedeflerime ulasmak icin birden fazla yol dusunebilirim.", "reverse_coded": false},
    {"id": "upcap_02", "subscale": "hope", "text_tr": "Suanda isimde kendimi oldukca basarili goruyorum.", "reverse_coded": false},
    {"id": "upcap_03", "subscale": "hope", "text_tr": "Isimdeki hedeflerime enerjik bir sekilde ulasiyorum.", "reverse_coded": false},
    {"id": "upcap_04", "subscale": "efficacy", "text_tr": "Is problemlerine cozum bulmakta kendime guveniyorum.", "reverse_coded": false},
    {"id": "upcap_05", "subscale": "efficacy", "text_tr": "Stratejik konularda tartisirken kendime guveniyorum.", "reverse_coded": true},
    {"id": "upcap_06", "subscale": "efficacy", "text_tr": "Uzun vadeli is hedefleri belirlerken kendime guveniyorum.", "reverse_coded": false},
    {"id": "upcap_07", "subscale": "resilience", "text_tr": "Isimdeki zorluklari genellikle bir sekilde atlatabilirim.", "reverse_coded": false},
    {"id": "upcap_08", "subscale": "resilience", "text_tr": "Istersem gerekiyorsa isimde kendi basima olabilirim.", "reverse_coded": true},
    {"id": "upcap_09", "subscale": "resilience", "text_tr": "Isimdeki zor dususleri atlatabilirim.", "reverse_coded": false},
    {"id": "upcap_10", "subscale": "optimism", "text_tr": "Isimde belirsiz zamanlarda en iyisini umuyorum.", "reverse_coded": false},
    {"id": "upcap_11", "subscale": "optimism", "text_tr": "Eger isimde bir sey ters gidebiliyorsa gidecek.", "reverse_coded": true},
    {"id": "upcap_12", "subscale": "optimism", "text_tr": "Isimde her seyin iyi tarafina bakiyorum.", "reverse_coded": false}
  ]
}
