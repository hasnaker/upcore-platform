# ============================================================================
# UpCore Platform — Ortam Değişkenleri Örneği
# ----------------------------------------------------------------------------
# Kurulum:
#   cp .env.example .env                       (docker compose için)
#   cp .env.example apps/web/.env.local        (lokal pnpm dev için)
# Clerk JWT template kurulumu: docs/CLERK_SETUP.md
# ============================================================================

# ---- Ortam ----
APP_ENV=development
NODE_ENV=development
LOG_LEVEL=info
TZ=Europe/Istanbul

# ============================================================================
# Veritabanı & Cache
# ============================================================================
POSTGRES_USER=upcore
POSTGRES_PASSWORD=upcore_dev_password
POSTGRES_DB=upcore_dev
DATABASE_URL=postgres://upcore:upcore_dev_password@localhost:5432/upcore_dev?sslmode=disable
DATABASE_MAX_CONNECTIONS=25
DATABASE_SSL_MODE=disable

REDIS_URL=redis://:upcore_redis_dev@localhost:6379/0
REDIS_TTL_SECONDS=3600

# ============================================================================
# Azure Service Bus (Prod — lokalde boş)
# ============================================================================
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_NAMESPACE=upcore-dev

# ============================================================================
# Azure OpenAI (LLM)
# ============================================================================
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_GPT4=gpt-4o
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ============================================================================
# Azure Blob Storage (Prod / Azurite lokal)
# ============================================================================
# Lokal Azurite için:
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;
# Prod:
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER_DOCUMENTS=documents
AZURE_STORAGE_CONTAINER_REPORTS=reports

# ============================================================================
# SMTP (Mailhog lokal / prod SendGrid/Azure Email)
# ============================================================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@upcore.local

# ============================================================================
# Clerk Auth
# ----------------------------------------------------------------------------
# KURULUM ADIMLARI:
#  1. https://dashboard.clerk.com → create application
#  2. API Keys sekmesi → Publishable + Secret keys buraya
#  3. JWT Templates → "upcore" template oluştur → claims:
#       { "tenant_id": "{{org.public_metadata.tenant_id}}",
#         "roles":     "{{org.public_metadata.roles}}",
#         "email":     "{{user.primary_email_address}}" }
#  4. Webhooks → Add endpoint: https://api.upcore.app/webhooks/clerk
#       (lokalde: ngrok / cloudflared ile tunnel aç)
#       events: user.created, user.updated, user.deleted, session.*
#       Signing Secret → CLERK_WEBHOOK_SECRET
#  5. Organizations enable → her tenant = Clerk organization
# ============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_TODO
CLERK_SECRET_KEY=sk_test_TODO
CLERK_WEBHOOK_SECRET=whsec_TODO
CLERK_JWKS_URL=https://api.clerk.dev/v1/jwks
CLERK_ISSUER=https://clerk.upcore.app
JWT_AUDIENCE=upcore-api

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/giris
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/kayit
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/panel
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Development-only request context fallbacks for local BFF routes.
# Production must use gateway-authenticated headers.
DEV_TENANT_ID=11111111-1111-1111-1111-111111111111
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_USER_ROLE=hr_director

# ============================================================================
# Observability (Prod)
# ============================================================================
APPLICATIONINSIGHTS_CONNECTION_STRING=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ============================================================================
# Frontend Public
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENV=development
NEXT_TELEMETRY_DISABLED=1

# ============================================================================
# API Gateway
# ============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_PER_USER=100
RATE_LIMIT_PER_TENANT=1000
RATE_LIMIT_WINDOW_SEC=60

# ============================================================================
# ATS / Import Limits
# ============================================================================
IMPORT_BATCH_SIZE=500
IMPORT_MAX_ROWS=10000
IMPORT_MAX_FILE_MB=10

# ============================================================================
# Bordro Entegrasyon (Faz 2)
# ============================================================================
LOGO_API_BASE_URL=
LOGO_API_KEY=
PARASUT_CLIENT_ID=
PARASUT_CLIENT_SECRET=
