# ============================================================================
# Clerk Authentication
# ============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/giris
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/kayit
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/panel
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ============================================================================
# Backend Services
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
TENANT_SERVICE_URL=http://localhost:8081
AUTH_SERVICE_URL=http://localhost:8082

# ============================================================================
# Environment
# ============================================================================
NEXT_PUBLIC_ENV=development
NODE_ENV=development

# ============================================================================
# Blog & Marketing
# ============================================================================
# Plausible (cookie-less analytics). Domain tanımlı değilse script yüklenmez.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.outbound-links.tagged-events.js

# Newsletter double opt-in provider: postmark | brevo | none
NEWSLETTER_PROVIDER=none

# Postmark (eğer NEWSLETTER_PROVIDER=postmark ise)
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=hello@upcore.app

# Brevo (eğer NEWSLETTER_PROVIDER=brevo ise)
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_TEMPLATE_ID=
BREVO_REDIRECT_URL=https://upcore.app/blog?subscribed=ok
