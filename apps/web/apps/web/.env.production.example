# Upcore Production Environment

# API URLs (Azure Container Apps)
NEXT_PUBLIC_API_URL=https://api.upcore.io
NEXT_PUBLIC_APP_URL=https://app.upcore.io

# Clerk (Production keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/giris
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/kayit

# Backend service URLs (internal)
EMPLOYEE_SERVICE_URL=http://employee:8003
ORGANIZATION_SERVICE_URL=http://organization:8004
LEAVE_SERVICE_URL=http://leave:8005
DOCUMENT_SERVICE_URL=http://document:8006
SURVEY_SERVICE_URL=http://survey:8007
INTERVENTION_SERVICE_URL=http://intervention:8008
ATS_SERVICE_URL=http://ats:8011
ASSESSMENT_SERVICE_URL=http://assessment:8012

# ML services (internal)
SCORING_SERVICE_URL=http://psychometric-scoring:8025
BURNOUT_SERVICE_URL=http://burnout-prediction:8022
RECOMMEND_SERVICE_URL=http://recommendation:8023
ACTION_SERVICE_URL=http://action-center:8024

# Database (Azure PostgreSQL)
DATABASE_URL=postgresql://upcore_admin:...@upc-prod-pg-flex.postgres.database.azure.com:5432/upcore?sslmode=require

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://upc-prod-openai.openai.azure.com
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=...
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=production

# Feature Flags
NEXT_PUBLIC_ENV=production
NODE_ENV=production
