# UpCore Admin Panel — Ortam Değişkenleri
#
# Kopya oluştur:  cp .env.example .env.local
# Clerk Dashboard'dan production/dev key'lerini al ve doldur.

# ---- Clerk ----
# Admin panel için AYRI Clerk application kullan (prod'da web'den izole).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/giris
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# ---- Admin API (tenant service üstünde role-gated) ----
NEXT_PUBLIC_API_URL=http://localhost:8080
